        if (activeRole === 'TEKNIK_UZMAN' || activeRole === 'ADMIN') {
            talepItems.push({ label: activeRole === 'ADMIN' ? 'Teknik İş Havuzu' : 'İş Havuzum', icon: 'pi pi-fw pi-wrench', to: '/is-havuzu' });
        }
        if (activeRole === 'KOORDINATOR' || activeRole === 'ADMIN') {
            talepItems.push({ label: activeRole === 'ADMIN' ? 'Sistem Süreç Takibi' : 'Süreç Takip / Koordinatör', icon: 'pi pi-fw pi-sliders-h', to: '/koordinator' });
        }

        const kurumsalItems = [];
