'use client';

import React, { useState, useRef } from 'react';
import { useRouter } from 'next/navigation';
import { useTickets, Ticket } from '@/layout/context/TicketContext';
import { InputText } from 'primereact/inputtext';
import { InputTextarea } from 'primereact/inputtextarea';
import { Dropdown } from 'primereact/dropdown';
import { MultiSelect } from 'primereact/multiselect';
import { SelectButton } from 'primereact/selectbutton';
import { Button } from 'primereact/button';
import { Card } from 'primereact/card';
import { Toast } from 'primereact/toast';

const YeniTalepPage = () => {
    const router = useRouter();
    const { addTicket } = useTickets();
    const toast = useRef<Toast>(null);

    // Ana Parametreler
    const [requester, setRequester] = useState('');
    const [category, setCategory] = useState<string>('Donanım/Arıza');
    const [subCategory, setSubCategory] = useState<string>('');
    const [priority, setPriority] = useState<Ticket['priority']>('Normal');
    
    // Donanım Parametreleri
    const [serialNo, setSerialNo] = useState('');
    const [building, setBuilding] = useState('');
    const [roomNo, setRoomNo] = useState('');
    const [hardwareSymptoms, setHardwareSymptoms] = useState<string[]>([]);
    
    // Yazılım / Erişim Parametreleri
    const [systemName, setSystemName] = useState('');
    const [accessLevel, setAccessLevel] = useState('Salt Okunur (Read-Only)');
    const [accessDuration, setAccessDuration] = useState('Sürekli');
    const [projectCode, setProjectCode] = useState('');

    // İdari Hizmet Parametreleri
    const [facilityScope, setFacilityScope] = useState('');
    const [locationDetail, setLocationDetail] = useState('');

    // Güvenlik Parametreleri
    const [securityAsset, setSecurityAsset] = useState('');
    const [ipAddress, setIpAddress] = useState('');

    // Opsiyonel Ek Not
    const [extraNotes, setExtraNotes] = useState('');
    const [isSubmitting, setIsSubmitting] = useState(false);
    const submitLock = useRef(false);

    // Sınıflandırma Seçenekleri
    const categoryOptions = [
        { label: 'Donanım / Cihaz Arızası', value: 'Donanım/Arıza' },
        { label: 'Yazılım / Yetki ve Erişim Talebi', value: 'Ysazılım/Erişim' },
        { label: 'İdari / Tesis ve Destek Hizmetleri', value: 'İdari Hizmet' },
        { label: 'Bilgi Güvenliği / Olay Bildirimi', value: 'Güvenlik' }
    ];

    const subCategoryMapping: Record<string, { label: string; value: string }[]> = {
        'Donanım/Arıza': [
            { label: 'Masaüstü / Dizüstü Bilgisayar', value: 'PC' },
            { label: 'Yazıcı / Tarayıcı / Çevre Birimi', value: 'CEVRE_BIRIMI' },
            { label: 'Ağ Anahtarı (Switch) / Wi-Fi Erişim Noktası', value: 'AG_DONANIMI' },
            { label: 'Sunucu / Sistem Odası Donanımı', value: 'SUNUCU' }
        ],
        'Yazılım/Erişim': [
            { label: 'Veritabanı Erişim / Tablo Yetkisi', value: 'VERITABANI' },
            { label: 'ERP / EBYS / Kurumsal Yazılım Yetkisi', value: 'ERP_EBYS' },
            { label: 'Geliştirme / Mühendislik Lisansı Talebi', value: 'LISANS' },
            { label: 'VPN / Güvenli Ağ Erişimi', value: 'VPN' }
        ],
        'İdari Hizmet': [
            { label: 'İklimlendirme / Klima Bakımı', value: 'IKLIMLENDIRME' },
            { label: 'Elektrik / Aydınlatma / Kesintisiz Güç', value: 'ELEKTRIK' },
            { label: 'Ofis Yerleşim / Masa Taşıma', value: 'YERLESIM' },
            { label: 'Sıhhi Tesisat / Genel Bakım', value: 'TESISAT' }
        ],
        'Güvenlik': [
            { label: 'Oltalama (Phishing) E-posta Bildirimi', value: 'PHISHING' },
            { label: 'Zararlı Yazılım / Virüs Tespiti', value: 'MALWARE' },
            { label: 'Yetkisiz Erişim / Şüpheli Giriş Denemesi', value: 'UNAUTHORIZED' },
            { label: 'Veri Bütünlüğü / Güvenlik Açığı', value: 'VULNERABILITY' }
        ]
    };

    const hardwareSymptomOptions = [
        { label: 'Cihaz Hiç Açılmıyor / Güç Yok', value: 'GUC_YOK' },
        { label: 'Mavi Ekran / Beklenmedik Kapanma', value: 'MAVI_EKRAN' },
        { label: 'Aşırı Isınma / Fan Gürültüsü', value: 'ISINMA' },
        { label: 'Fiziksel Hasar / Port/Kablo Kırık', value: 'FIZIKSEL_HASAR' },
        { label: 'Ağ Bağlantısı / IP Alamama Sorunu', value: 'AG_BAGLANTI' },
        { label: 'Yavaş Çalışma / Kilitlenme', value: 'PERFORMANS' }
    ];

    const priorityOptions = [
        { label: 'Düşük (Rutin / Bekleyebilir)', value: 'Düşük' },
        { label: 'Normal (Standart İşleyiş)', value: 'Normal' },
        { label: 'Yüksek (Birim İşi Aksıyor)', value: 'Yüksek' },
        { label: 'Kritik (Operasyon / Test Durdu)', value: 'Kritik' }
    ];

    const handleSubmit = async (e: React.FormEvent) => {
        e.preventDefault();

        if (submitLock.current) {
            return;
        }

        if (!subCategory) {
            toast.current?.show({
                severity: 'warn',
                summary: 'Eksik Seçim',
                detail: 'Lütfen talep alt türünü seçiniz.',
                life: 3000
            });
            return;
        }

        submitLock.current = true;
        setIsSubmitting(true);

        const generatedTitle = `[${category}] ${subCategory} - ${building || systemName || facilityScope || securityAsset || 'Standart Talep'}`;
        
        let structuredDetails = `Talep Alt Türü: ${subCategory}\n`;
        if (category === 'Donanım/Arıza') {
            structuredDetails += `Demirbaş: ${serialNo || 'N/A'} | Lokasyon: ${building} - Oda: ${roomNo}\nBelirtiler: ${hardwareSymptoms.join(', ') || 'Belirtilmedi'}`;
        } else if (category === 'Yazılım/Erişim') {
            structuredDetails += `Sistem: ${systemName} | Yetki: ${accessLevel} | Süre: ${accessDuration} | Proje: ${projectCode || 'N/A'}`;
        } else if (category === 'İdari Hizmet') {
            structuredDetails += `Kapsam: ${facilityScope} | Lokasyon: ${locationDetail}`;
        } else if (category === 'Güvenlik') {
            structuredDetails += `Etkilenen Varlık: ${securityAsset} | IP/MAC: ${ipAddress || 'N/A'}`;
        }

        if (extraNotes.trim()) {
            structuredDetails += `\nEk Personel Notu: ${extraNotes}`;
        }

        const created = await addTicket({
            title: generatedTitle,
            category: category as Ticket['category'],
            priority,
            description: structuredDetails,
            location: building ? `${building} / ${roomNo}` : locationDetail || undefined,
            serialNo: serialNo || undefined,
            requester
        });

        if (!created) {
            submitLock.current = false;
            setIsSubmitting(false);
            toast.current?.show({ severity: 'error', summary: 'Talep Oluşturulamadı', detail: 'Zorunlu alanları kontrol ediniz.', life: 3000 });
            return;
        }

        toast.current?.show({
            severity: 'success',
            summary: 'Kayıt Oluşturuldu',
            detail: 'Parametrik talep standartlara uygun şekilde işleme alındı.',
            life: 2000
        });

        setTimeout(() => {
            router.push('/taleplerim');
        }, 1200);
    };

    return (
        <div className="grid">
            <Toast ref={toast} />
            <div className="col-12 lg:col-10 lg:col-offset-1">
                <Card 
                    title="Parametrik Talep ve Arıza Bildirim Formu" 
                    subTitle="Serbest metin karmaşasını önlemek adına tüm alanlar teknik sınıflandırma standartlarına bağlanmıştır."
                >
                    <form onSubmit={handleSubmit} className="p-fluid">
                        
                        <div className="formgrid grid mb-4">
                            <div className="field col-12 md:col-4">
                                <label className="font-bold">Personel Adı Soyadı</label>
                                <InputText value={requester} onChange={(e) => setRequester(e.target.value)} 
                                placeholder="Personel Adı Soyadı" required/>
                            </div>
                            <div className="field col-12 md:col-4">
                                <label className="font-bold">Personel Sicil Numarası</label>
                                <InputText value={requester} onChange={(e) => setRequester(e.target.value)} 
                                placeholder="Personel Sicil Numarası" required/>
                            </div>
                            <div className="field col-12 md:col-4">
                                <label className="font-bold">Personel Unvanı</label>
                                <InputText value={requester} onChange={(e) => setRequester(e.target.value)} 
                                placeholder="Personel Unvanı" required/>
                            </div>

                            <div className="field col-12 md:col-4">
                                <label className="font-bold">Personel e-postası</label>
                                <InputText value={requester} onChange={(e) => setRequester(e.target.value)} 
                                placeholder="Personel e-postası" required/>
                            </div>

