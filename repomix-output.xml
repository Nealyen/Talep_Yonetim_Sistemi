                                        r.status === 'KAPATILDI' ? 'success' : r.status === 'ONAY_BEKLİYOR' ? 'warning' : r.status === 'İŞLEMDE' ? 'warning' : 'info'
                                    }
                                />
                            )}
                        />
                    </DataTable>
                </div>
            </div>
        </div>
    );
};

