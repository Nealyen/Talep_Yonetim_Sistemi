];

const TicketContext = createContext<TicketContextType | undefined>(undefined);

export const TicketProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
    const [tickets, setTickets] = useState<Ticket[]>(defaultTickets);
    const [users, setUsers] = useState<SystemUser[]>(defaultUsers);
    const [activeRole, setActiveRole] = useState<UserRole>('ADMIN');
    const [isLoading, setIsLoading] = useState(true);
    const [loadError, setLoadError] = useState<string | null>(null);

    useEffect(() => {
        const savedRole = localStorage.getItem('activeRole') as UserRole | null;
        let requestRole: UserRole = 'ADMIN';
        let requestUserName = '';
        if (savedRole && ['TALEP_SAHIBI', 'TEKNIK_UZMAN', 'KOORDINATOR', 'ADMIN'].includes(savedRole)) {
            setActiveRole(savedRole);
            requestRole = savedRole;
        }
        try {
            const savedUser = localStorage.getItem('authUser');
            requestUserName = savedUser ? JSON.parse(savedUser).name || '' : '';
        } catch {
            requestUserName = '';
        }
        if (!requestUserName && requestRole === 'TEKNIK_UZMAN') requestUserName = 'Mehmet Demir';
        if (!requestUserName && requestRole === 'TALEP_SAHIBI') requestUserName = 'Ahmet Yılmaz';
        const ticketQuery = new URLSearchParams({ role: requestRole, userName: requestUserName });
        Promise.all([fetch(`/api/tickets?${ticketQuery.toString()}`), fetch(`/api/users?role=${requestRole}`)])
            .then(async ([ticketsResponse, usersResponse]) => {
                if (!ticketsResponse.ok || !usersResponse.ok) throw new Error('Veriler yüklenemedi.');
                const [ticketData, userData] = await Promise.all([ticketsResponse.json(), usersResponse.json()]);
                setTickets(ticketData as Ticket[]);
                setUsers(userData as SystemUser[]);
                setLoadError(null);
            })
            .catch(() => setLoadError('Veriler yüklenemedi. Demo verileri gösteriliyor.'))
            .finally(() => setIsLoading(false));
    }, []);

    const refreshTickets = async () => {
        const response = await fetch('/api/tickets');
        if (!response.ok) throw new Error('Ticket API okunamadı.');
        setTickets(await response.json());
    };

    const updateUserRole = async (userId: string, role: UserRole): Promise<boolean> => {
        if (activeRole !== 'ADMIN') {
            return false;
        }

        const user = users.find((item) => item.id === userId);
        if (!user || user.role === 'ADMIN') {
            return false;
        }

        const response = await fetch('/api/users', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId, role, actorRole: activeRole }) });
        if (!response.ok) return false;
        const updated = users.map((item) => (item.id === userId ? { ...item, role } : item));
        setUsers(updated);
        return true;
    };

    const switchRoleAndReload = (role: UserRole) => {
        localStorage.setItem('activeRole', role);
        window.location.href = '/';
    };

    const getActorName = () => {
        try {
            const savedUser = localStorage.getItem('authUser');
            return savedUser ? JSON.parse(savedUser).name || activeRole : activeRole;
        } catch {
            return activeRole;
        }
    };

    const addTicket = async (data: Omit<Ticket, 'id' | 'createdAt' | 'history' | 'status' | 'assignee'>): Promise<boolean> => {
        if (!data.title.trim() || !data.description.trim() || !data.requester.trim()) {
            return false;
        }
        const response = await fetch('/api/tickets', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (!response.ok) return false;
        await refreshTickets();
        return true;
    };

    const assignTicket = async (ticketId: string, technicianName: string, actorName?: string, actorRole?: UserRole): Promise<boolean> => {
        const ticket = tickets.find((item) => item.id === ticketId);
        const normalizedTechnicianName = technicianName.trim();
        const technicianKey = normalizedTechnicianName.split(' (')[0].trim();
        const technicianHasAnotherActiveTicket = tickets.some(
            (item) =>
                item.id !== ticketId &&
                item.assignee &&
                item.assignee.split(' (')[0].trim() === technicianKey &&
                !['KAPATILDI', 'REDDEDİLDİ'].includes(item.status)
        );
        if (!ticket || !normalizedTechnicianName || technicianHasAnotherActiveTicket || ['KAPATILDI', 'REDDEDİLDİ'].includes(ticket.status)) {
            return false;
        }
        const response = await fetch(`/api/tickets/${ticketId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ assignee: normalizedTechnicianName, status: 'İŞLEMDE', actorName: actorName || getActorName(), actorRole: actorRole || activeRole }) });
        if (!response.ok) return false;
        await refreshTickets();
        return true;
    };

    const unassignTicket = async (ticketId: string, actorName?: string, actorRole?: UserRole): Promise<boolean> => {
        const ticket = tickets.find((item) => item.id === ticketId);
        if (!ticket || !ticket.assignee || ['KAPATILDI', 'REDDEDİLDİ'].includes(ticket.status)) {
            return false;
        }
        const response = await fetch(`/api/tickets/${ticketId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ assignee: null, status: 'YENİ', actorName: actorName || getActorName(), actorRole: actorRole || activeRole }) });
        if (!response.ok) return false;
        await refreshTickets();
        return true;
    };

    const completeTicket = async (ticketId: string, actorName?: string): Promise<boolean> => {
        const ticket = tickets.find((item) => item.id === ticketId);
        if (!ticket || ticket.status !== 'İŞLEMDE' || !ticket.assignee) {
            return false;
        }
        const response = await fetch(`/api/tickets/${ticketId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'ONAY_BEKLİYOR', actorName: actorName || getActorName(), actorRole: activeRole }) });
        if (!response.ok) return false;
        await refreshTickets();
        return true;
    };

    const confirmTicket = async (ticketId: string, approved: boolean, actorName?: string): Promise<boolean> => {
        const ticket = tickets.find((item) => item.id === ticketId);
        if (!ticket || ticket.status !== 'ONAY_BEKLİYOR') {
            return false;
        }
        const response = await fetch(`/api/tickets/${ticketId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: approved ? 'KAPATILDI' : 'İŞLEMDE', actorName: actorName || getActorName(), actorRole: activeRole }) });
        if (!response.ok) return false;
        await refreshTickets();
        return true;
    };

    return (
        <TicketContext.Provider
            value={{
                tickets,
                users,
                isLoading,
                loadError,
                activeRole,
                switchRoleAndReload,
                updateUserRole,
                addTicket,
                assignTicket,
                unassignTicket,
                completeTicket,
                confirmTicket
            }}
        >
            {children}
        </TicketContext.Provider>
    );
};

export const useTickets = () => {
    const context = useContext(TicketContext);
    if (!context) {
        throw new Error('useTickets must be used within a TicketProvider');
    }
    return context;
};
</file>

