<file path="app/(main)/taleplerim/page.tsx">
'use client';

import React, { useEffect, useState } from 'react';
import { useTickets, Ticket } from '@/layout/context/TicketContext';
import { DataTable } from 'primereact/datatable';
import { Column } from 'primereact/column';
import { Tag } from 'primereact/tag';
import { Button } from 'primereact/button';
import { Dialog } from 'primereact/dialog';
import { Card } from 'primereact/card';
import { Timeline } from 'primereact/timeline';
import { InputText } from 'primereact/inputtext';
import { Dropdown } from 'primereact/dropdown';
import { Message } from 'primereact/message';

const TaleplerimPage = () => {
    const { tickets, activeRole, confirmTicket, isLoading, loadError } = useTickets();
    const [selectedTicket, setSelectedTicket] = useState<Ticket | null>(null);
    const [dialogVisible, setDialogVisible] = useState(false);
    const [search, setSearch] = useState('');
    const [statusFilter, setStatusFilter] = useState<string | null>(null);
    const [priorityFilter, setPriorityFilter] = useState<string | null>(null);
    const [currentUserName, setCurrentUserName] = useState('');
    const [currentUserRole, setCurrentUserRole] = useState<string | null>(null);

    useEffect(() => {
        const savedUser = localStorage.getItem('authUser');
        if (savedUser) {
            try {
                setCurrentUserName(JSON.parse(savedUser).name || '');
                setCurrentUserRole(JSON.parse(savedUser).role || null);
            } catch {
                setCurrentUserName('');
            }
        }
    }, []);

    const normalizeName = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('tr-TR');
    const effectiveUserName = currentUserName || (activeRole === 'TEKNIK_UZMAN' ? 'Mehmet Demir' : activeRole === 'TALEP_SAHIBI' ? 'Ahmet Yılmaz' : '');
    const isTestRole = currentUserRole === null || currentUserRole !== activeRole;
    const ownedTickets = activeRole === 'ADMIN' || activeRole === 'KOORDINATOR' || isTestRole
        ? tickets
        : activeRole === 'TEKNIK_UZMAN'
            ? tickets.filter((ticket) => normalizeName(ticket.assignee || '').includes(normalizeName(effectiveUserName)))
            : tickets.filter((ticket) => normalizeName(ticket.requester).includes(normalizeName(effectiveUserName)));

    const getStatusSeverity = (status: Ticket['status']) => {
        switch (status) {
            case 'YENİ': return 'info';
            case 'İŞLEMDE': return 'warning';
            case 'ONAY_BEKLİYOR': return 'warning';
            case 'KAPATILDI': return 'success';
            case 'REDDEDİLDİ': return 'danger';
            default: return null;
        }
    };

    const filteredTickets = ownedTickets.filter((ticket) => {
        const query = search.toLocaleLowerCase('tr-TR');
        return (!query || `${ticket.id} ${ticket.title} ${ticket.category}`.toLocaleLowerCase('tr-TR').includes(query)) && (!statusFilter || ticket.status === statusFilter) && (!priorityFilter || ticket.priority === priorityFilter);
    });
    const returnedForRevision = filteredTickets.filter((ticket) => ticket.history[ticket.history.length - 1]?.action === 'UZMAN_ILISKISI_KESILDI');

    const actionBodyTemplate = (rowData: Ticket) => {
        return (
            <div className="flex gap-2">
                <Button
                    icon="pi pi-eye"
                    rounded
                    outlined
                    severity="secondary"
                    onClick={() => {
                        setSelectedTicket(rowData);
                        setDialogVisible(true);
                    }}
                    tooltip="Detay ve Tarihçe"
                />
                {rowData.status === 'ONAY_BEKLİYOR' && (
                    <>
                        <Button
                            icon="pi pi-check"
                            rounded
                            severity="success"
                            onClick={() => confirmTicket(rowData.id, true, currentUserName || rowData.requester)}
                            tooltip="Çözümü Onayla (Kapat)"
                        />
                        <Button
                            icon="pi pi-times"
                            rounded
                            severity="danger"
                            onClick={() => confirmTicket(rowData.id, false, currentUserName || rowData.requester)}
                            tooltip="Sorun Sürüyor (İtiraz Et)"
                        />
                    </>
                )}
            </div>
        );
    };

    return (
        <div className="grid">
            <div className="col-12">
                <Card title="Açtığım Resmi Talepler" subTitle="Oluşturduğunuz taleplerin süreç aşamaları ve doğrulama onayları.">
                    {returnedForRevision.length > 0 && (
                        <Message
                            severity="warn"
                            className="w-full mb-3"
                            text={`${returnedForRevision.length} talebinizde teknik uzman ilişkisi kesildi. Talepler yeniden iş havuzunda değerlendirilecek.`}
                        />
                    )}
                    {isLoading && <Message severity="info" className="w-full mb-3" text="Talepler yükleniyor..." />}
                    {loadError && <Message severity="warn" className="w-full mb-3" text={loadError} />}
                    <div className="flex flex-wrap gap-2 mb-3">
                        <InputText value={search} onChange={(event) => setSearch(event.target.value)} placeholder="Talep ara..." />
                        <Dropdown value={statusFilter} options={['YENİ', 'İŞLEMDE', 'ONAY_BEKLİYOR', 'KAPATILDI', 'REDDEDİLDİ']} onChange={(event) => setStatusFilter(event.value)} placeholder="Durum" showClear />
                        <Dropdown value={priorityFilter} options={['Düşük', 'Normal', 'Yüksek', 'Kritik']} onChange={(event) => setPriorityFilter(event.value)} placeholder="Öncelik" showClear />
                    </div>
                    <DataTable value={filteredTickets} paginator rows={10} dataKey="id" responsiveLayout="scroll" emptyMessage="Kayıtlı talep bulunamadı.">
                        <Column field="id" header="Talep No" sortable style={{ width: '120px' }} />
                        <Column field="title" header="Talep Başlığı" sortable />
                        <Column field="category" header="Kategori" sortable style={{ width: '150px' }} />
                        <Column field="priority" header="Aciliyet" sortable style={{ width: '100px' }} />
                        <Column
                            field="status"
                            header="Durum"
                            sortable
                            style={{ width: '150px' }}
                            body={(rowData: Ticket) => <Tag value={rowData.status} severity={getStatusSeverity(rowData.status)} />}
                        />
                        <Column field="assignee" header="Atanan Uzman" body={(r: Ticket) => r.assignee || 'Henüz Atanmadı'} />
                        <Column field="createdAt" header="Tarih" sortable style={{ width: '150px' }} />
                        <Column header="İşlemler" body={actionBodyTemplate} style={{ width: '160px' }} />
                    </DataTable>
                </Card>
            </div>

            {/* Talep Detay ve Audit Log Modalı */}
            <Dialog header={`Talep Detayı - ${selectedTicket?.id}`} visible={dialogVisible} style={{ width: '600px' }} onHide={() => setDialogVisible(false)}>
                {selectedTicket && (
                    <div>
                        <div className="mb-4">
                            <h5 className="mb-2 font-bold">{selectedTicket.title}</h5>
                            <pre className="p-3 surface-ground border-round white-space-pre-wrap font-sans text-sm">{selectedTicket.description}</pre>
                        </div>
                        <h6 className="font-bold mb-3">Süreç Tarihçesi & Denetim İzi</h6>
                        <Timeline value={selectedTicket.history} opposite={(item) => <small className="text-color-secondary">{item.date}</small>} content={(item) => (
                            <div className="mb-2">
                                <div className="font-bold text-sm">{item.action}</div>
                                <small className="text-500">İşlem Yapan: {item.user}</small>
                            </div>
                        )} />
                    </div>
                )}
            </Dialog>
        </div>
    );
};

export default TaleplerimPage;
</file>

