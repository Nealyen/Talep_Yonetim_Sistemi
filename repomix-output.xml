    font-size: 1rem;
    font-weight: normal;
  }

  .p-component-overlay {
    background-color: rgba(0, 0, 0, 0.32);
    transition-duration: 0.2s;
  }

  .p-disabled, .p-component:disabled {
    opacity: 0.38;
  }

  .p-error {
    color: #f44435;
  }

  .p-text-secondary {
    color: rgba(255, 255, 255, 0.6);
  }

